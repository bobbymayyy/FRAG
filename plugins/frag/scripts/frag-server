#!/usr/bin/env python3
"""
Claude Code plugin entry point for FRAG.

The launcher is intentionally dependency-free. It does not create a venv or
run pip: MCP startup may happen inside Claude Code's sandbox with no PyPI
access, and a server should not need network access merely to come online.

Instead, the bundled ``src`` directory is prepended to PYTHONPATH and the MCP
module is exec'd with the same Python interpreter Claude used to start this
script. Repo clones and indexes still live in CLAUDE_PLUGIN_DATA so they
persist across plugin updates.

Claude Code may leave optional userConfig substitutions empty or, depending
on client/version, pass the literal ``${user_config.foo}`` placeholder. Those
values are scrubbed here so an unconfigured host fails clearly when its tool
is called rather than being handed a fake credential.

stdout is reserved for MCP JSON-RPC framing. Diagnostics go to stderr.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path


OPTIONAL_CONFIG_ENV = (
    "FRAG_GITHUB_TOKEN",
    "FRAG_GITHUB_DEFAULT_OWNER",
    "FRAG_GITEA_URL",
    "FRAG_GITEA_TOKEN",
    "FRAG_GITEA_DEFAULT_OWNER",
)


def log(msg: str) -> None:
    print(f"[frag-server] {msg}", file=sys.stderr, flush=True)


def resolved_path(value: str | None, fallback: Path) -> Path:
    """Resolve a Claude plugin path while tolerating an unsubstituted value."""
    if not value or "${" in value:
        return fallback
    return Path(value).expanduser()


def sanitize_optional_config(env: dict[str, str]) -> None:
    """Drop optional config values that Claude did not actually substitute."""
    for key in OPTIONAL_CONFIG_ENV:
        value = env.get(key)
        if value is None:
            continue
        stripped = value.strip()
        if not stripped or (
            stripped.startswith("${user_config.") and stripped.endswith("}")
        ):
            env.pop(key, None)


def main() -> int:
    bundled_root = Path(__file__).resolve().parent.parent
    root = resolved_path(os.environ.get("FRAG_PLUGIN_ROOT"), bundled_root)
    data = resolved_path(
        os.environ.get("FRAG_PLUGIN_DATA"),
        Path.home() / ".frag" / "plugin-data",
    )
    src = root / "src"

    if not (src / "frag" / "mcp_server.py").is_file():
        log(f"FATAL: bundled FRAG source missing at {src}")
        return 1

    env = os.environ.copy()
    sanitize_optional_config(env)

    env["FRAG_PLUGIN_ROOT"] = str(root)
    env["FRAG_PLUGIN_DATA"] = str(data)

    frag_home = env.get("FRAG_HOME")
    if not frag_home or "${" in frag_home:
        env["FRAG_HOME"] = str(data / "home")

    existing_pythonpath = env.get("PYTHONPATH")
    env["PYTHONPATH"] = str(src) + (
        os.pathsep + existing_pythonpath if existing_pythonpath else ""
    )

    argv = [sys.executable, "-m", "frag.mcp_server", *sys.argv[1:]]
    try:
        os.execve(sys.executable, argv, env)
    except OSError as exc:
        log(f"FATAL: could not exec FRAG MCP server: {exc}")
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
