#!/usr/bin/env python3
"""Claude Code plugin entry point for FRAG.

The launcher is intentionally dependency-free. It does not create a venv or
run pip: MCP startup may happen inside Claude Code's sandbox with no PyPI
access, and a server should not need network access merely to come online.

User configuration is read from Claude Code's
``CLAUDE_PLUGIN_OPTION_<KEY>`` environment variables and normalized into
FRAG_* variables after process spawn. FRAG_REPO_HUB is optional; when absent,
the runtime auto-detects /srv/repos if that directory exists.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path


USER_CONFIG_ENV = {
    "FRAG_GITHUB_TOKEN": "CLAUDE_PLUGIN_OPTION_GITHUB_TOKEN",
    "FRAG_GITHUB_DEFAULT_OWNER": "CLAUDE_PLUGIN_OPTION_GITHUB_DEFAULT_OWNER",
    "FRAG_GITEA_URL": "CLAUDE_PLUGIN_OPTION_GITEA_URL",
    "FRAG_GITEA_TOKEN": "CLAUDE_PLUGIN_OPTION_GITEA_TOKEN",
    "FRAG_GITEA_DEFAULT_OWNER": "CLAUDE_PLUGIN_OPTION_GITEA_DEFAULT_OWNER",
    "FRAG_REPO_HUB": "CLAUDE_PLUGIN_OPTION_REPO_HUB",
}


def log(msg: str) -> None:
    print(f"[frag-server] {msg}", file=sys.stderr, flush=True)


def resolved_path(value: str | None, fallback: Path) -> Path:
    if not value or "${" in value:
        return fallback
    return Path(value).expanduser()


def configured_value(value: str | None) -> str | None:
    if value is None:
        return None
    stripped = value.strip()
    if not stripped or (stripped.startswith("${") and stripped.endswith("}")):
        return None
    return stripped


def apply_user_config(env: dict[str, str]) -> None:
    for target, option_env in USER_CONFIG_ENV.items():
        direct = configured_value(env.get(target))
        option = configured_value(env.get(option_env))

        if direct is not None:
            env[target] = direct
        elif option is not None:
            env[target] = option
        else:
            env.pop(target, None)

        env.pop(option_env, None)


def main() -> int:
    bundled_root = Path(__file__).resolve().parent.parent
    root = resolved_path(os.environ.get("FRAG_PLUGIN_ROOT"), bundled_root)
    data = resolved_path(
        os.environ.get("FRAG_PLUGIN_DATA"),
        Path.home() / ".frag" / "plugin-data",
    )
    src = root / "src"

    if not (src / "frag" / "mcp_server.py").is_file():
        log(f"FATAL: bundled FRAG source missing at {src}")
        return 1

    env = os.environ.copy()
    apply_user_config(env)

    env["FRAG_PLUGIN_ROOT"] = str(root)
    env["FRAG_PLUGIN_DATA"] = str(data)

    frag_home = env.get("FRAG_HOME")
    if not frag_home or "${" in frag_home:
        env["FRAG_HOME"] = str(data / "home")

    existing_pythonpath = env.get("PYTHONPATH")
    env["PYTHONPATH"] = str(src) + (
        os.pathsep + existing_pythonpath if existing_pythonpath else ""
    )

    argv = [sys.executable, "-m", "frag.mcp_server", *sys.argv[1:]]
    try:
        os.execve(sys.executable, argv, env)
    except OSError as exc:
        log(f"FATAL: could not exec FRAG MCP server: {exc}")
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
